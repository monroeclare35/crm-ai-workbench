# CRM AI 工作台 — 环境变量配置 (生产级模板)
# 复制此文件为 .env 并填入真实值

# ============================================
# Claude Agent SDK / 模型配置
# ============================================

# --- DeepSeek V4 (主力：日常对话、简单分析) ---
# 注意：deepseek-chat 已于 2026-07-24 弃用！必须使用 deepseek-v4-pro 或 deepseek-v4-flash
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-your-api-key-here
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_SMALL_FAST_MODEL=deepseek-v4-flash

# --- Kimi K2.6 (备用：复杂分析、深度推理) ---
# 注意：kimi-k2-turbo-preview 已停用！使用 kimi-k2.6 或 kimi-k2.7-code
ANTHROPIC_FALLBACK_BASE_URL=https://api.moonshot.ai/anthropic
ANTHROPIC_FALLBACK_AUTH_TOKEN=sk-your-moonshot-key
ANTHROPIC_FALLBACK_MODEL=kimi-k2.6

# --- Kimi 兼容性配置 ---
# Kimi 的 Anthropic 端点有已知差异：
# 1. temperature 会被内部缩放 (requested * 0.6)
# 2. document 类型 content block 返回 400
# 3. thinking 在多轮工具调用中可能返回 400
# 4. 不支持 prompt caching
# 所以：关闭 thinking，不使用 document block，不依赖 caching
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ============================================
# 数据库
# ============================================
# CRM 主库 (MySQL/TiDB)
CRM_DB_HOST=localhost
CRM_DB_PORT=3306
CRM_DB_USER=crm_agent
CRM_DB_PASSWORD=your-db-password
CRM_DB_NAME=crm_prod

# ============================================
# Redis (Session 持久化 + 缓存 + 消息队列)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Milvus 向量数据库 (知识库 RAG + Memory)
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=crm_knowledge

# ============================================
# Elasticsearch
# ============================================
ES_HOST=localhost
ES_PORT=9200

# ============================================
# 飞书 / 企业微信
# ============================================
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
WECOM_CORP_ID=your-wecom-corp-id
WECOM_CORP_SECRET=your-wecom-secret

# ============================================
# 应用
# ============================================
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
